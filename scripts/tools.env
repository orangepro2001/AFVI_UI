# tools.env - pinned versions and SHA-256 sums of the build tools that scripts/tools.sh downloads.
# Plain shell assignments. To upgrade: change the version, take the sum from the GitHub release
# page (asset "digest" / sha256sums.txt), run scripts/tools.sh --force, commit both.

# Tailwind CSS standalone executable (the project does not use the npm package).
TAILWINDCSS_VERSION=4.3.3
TAILWINDCSS_URL=https://github.com/tailwindlabs/tailwindcss/releases/download/v${TAILWINDCSS_VERSION}/tailwindcss-linux-x64
TAILWINDCSS_SHA256=dc61b3ac6b8c9ca874c0cc4c57b2409791a64c5540404ca5f5367360babc313a

# pnpm standalone bundle, only used when no pnpm is on PATH (the build server).
# Keep it equal to "packageManager" in frontend/package.json. pnpm then fetches the pinned Node
# (devEngines.runtime) and every dependency itself, with checksums from pnpm-lock.yaml.
PNPM_VERSION=12.14.0
PNPM_URL=https://github.com/pnpm/pnpm/releases/download/v${PNPM_VERSION}/pnpm-linux-x64.tar.gz
PNPM_SHA256=3910c3852136bed5bc1511b9137a45fd4357ed6b3970d9d08893641e9005867e
